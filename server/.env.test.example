# Settings for the automated tests (npm test). Copy this file to server/.env.test.
#
# The tests DROP and RECREATE the database named TEST_DB_NAME on every run, so it
# must be a throwaway database used for nothing else. The tests refuse to start
# unless its name contains "test". They never read DB_NAME.
#
# Any setting left out here is taken, for the connection only, from server/.env
# (DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_SSL, DB_SSL_CA). Nothing else in
# server/.env is used. Never point the tests at the live (Aiven) database.

# Name of the throwaway test database. Must contain "test".
TEST_DB_NAME=rtwc_test

# MySQL server for the tests, usually the one on this computer. The user needs
# permission to create and drop databases.
DB_HOST=127.0.0.1
# MySQL port (3306 unless your MySQL uses another one).
DB_PORT=3306
# MySQL user name.
DB_USER=
# MySQL password for that user.
DB_PASSWORD=
# false for a MySQL server on this computer, which has no certificate to check.
DB_SSL=false
# Path to a CA certificate, only when the test MySQL server needs SSL. Usually empty.
DB_SSL_CA=
