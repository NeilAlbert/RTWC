# =============================================================================
# ROYAL TEMPLE WORSHIP CENTRE — API ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
# =============================================================================

# --- Server ---
PORT=5000
# Comma-separated list of allowed origins for CORS (no trailing slash).
# The site's own domain(s) only.
CORS_ORIGIN=https://royaltemple.org,https://www.royaltemple.org

# --- MySQL / Aiven ---
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-strong-password
DB_NAME=royaltemple
# Optional: path (relative to server/) to the Aiven CA certificate (ca.pem).
# Recommended for certificate pinning. If omitted, SSL is still enforced
# with rejectUnauthorized: true against the system CA store.
DB_SSL_CA=./certs/ca.pem

# --- JWT Auth ---
# IMPORTANT: Generate this with `openssl rand -hex 64` — never type it by hand.
# It must be a long, random string (64 bytes of hex = 128 chars).
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_64_OUTPUT
# Token lifetime. 24h per spec.
JWT_EXPIRES_IN=24h

# --- Facebook Graph API (live stream + gallery) ---
PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# --- Email (Nodemailer) — contact/prayer notifications + giving receipts ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password-or-app-password
ADMIN_NOTIFICATION_EMAIL=info@royaltemple.org

# --- Paystack (online giving) ---
# Keys come from the Paystack dashboard: https://dashboard.paystack.com
# (Settings -> API Keys & Webhooks).
#   - Use TEST keys during development, and switch to LIVE keys only once you
#     are ready to accept real donations.
#   - PAYSTACK_SECRET_KEY is SERVER-ONLY and must NEVER appear in frontend
#     code, git history, or logs. PAYSTACK_PUBLIC_KEY is not used by this
#     integration (we use Paystack's hosted redirect checkout), but is listed
#     here for completeness/reference.
#   - Test mode card numbers (e.g. 4084 0840 8408 4081) work on the hosted
#     checkout while TEST keys are active.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where Paystack redirects the donor's browser back to after payment.
# For local testing this can be your localhost page (Paystack redirects the
# donor's browser, not a server callback). For production use the live site:
PAYSTACK_CALLBACK_URL=https://royaltemple.org/giving-callback.html

# --- Admin seed script (one-time, optional if CLI args used) ---
ADMIN_NAME=Royal Temple Admin
ADMIN_EMAIL=admin@royaltemple.org
ADMIN_PASSWORD=change-me-at-least-8-chars
