# =============================================================================
# ROYAL TEMPLE WORSHIP CENTRE — API ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
# =============================================================================

# --- Server ---
PORT=5000
# Comma-separated list of allowed origins for CORS (no trailing slash).
# The site's own domain(s) only.
# VERIFY: replace with the real address of the live site.
CORS_ORIGIN=https://royaltemple.org,https://www.royaltemple.org

# Number of reverse proxies between visitors and this server. The rate limits
# count per visitor IP, which Express reads from the X-Forwarded-For header.
#   1  behind one proxy: Nginx, or a hosting provider's proxy (the default)
#   2  behind Cloudflare AND Nginx
#   0  when browsers reach this server directly, e.g. on your own computer
# Too low and every visitor shares one rate-limit bucket (one person can lock
# out everyone). Too high and visitors can forge their address.
# (TRUST_PROXY, the older name, is still read if this is not set.)
TRUST_PROXY_HOPS=1

# --- MySQL / Aiven ---
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-strong-password
DB_NAME=royaltemple
# Optional: path (relative to server/) to the Aiven CA certificate (ca.pem).
# Recommended for certificate pinning. If omitted, SSL is still enforced
# with rejectUnauthorized: true against the system CA store.
DB_SSL_CA=./certs/ca.pem
# Only for a MySQL server on this same computer: set DB_SSL=false to connect
# without TLS. Leave it out for Aiven or any other hosted database.
# DB_SSL=false

# Database connections each server copy may open (mysql2 connectionLimit).
# Copies of the server x DB_POOL_SIZE must stay under the connection limit of
# your Aiven plan. Not read yet: it takes effect with the Docker setup (Phase 2).
DB_POOL_SIZE=5

# --- Redis (optional cache and shared rate limits; see REDIS.md) ---
# Off by default: without Redis the cache and rate limits live in this server's
# memory, which is fine for one server and for development.
REDIS_ENABLED=false
# redis://:PASSWORD@HOST:6379/0, or rediss:// for a managed Redis with TLS.
# Generate the password with `openssl rand -hex 32`. A Redis that is not on this
# computer must require a password, and must never be reachable from the
# internet. Leave empty to not use Redis.
REDIS_URL=
# Added to the start of every key, so this site's keys can be told apart and
# cleared without touching anything else in the same Redis.
REDIS_PREFIX=rtwc:

# --- Running several copies of the server (Phase 2) ---
# Not read yet: they take effect with the Docker setup.
# A name for this copy in the logs. Defaults to the machine's hostname.
INSTANCE_ID=
# true adds an X-Instance header to every response, to see load balancing while
# testing. Keep false on the live site: it tells visitors about your servers.
DEBUG_INSTANCE_HEADER=false

# --- JWT Auth ---
# IMPORTANT: Generate this with `openssl rand -hex 64` — never type it by hand.
# It must be a long, random string (64 bytes of hex = 128 chars).
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_64_OUTPUT
# Sign-in tokens last 24 hours. This is fixed in server/utils/tokens.js.

# --- Facebook Graph API (live stream + gallery) ---
PAGE_ID=your_facebook_page_id
# Page ID for https://www.facebook.com/cop.rtwc
# The numeric page ID can be found in the Page's About > Page transparency section
# or via the Graph API Explorer (developers.facebook.com/tools/explorer)
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# --- YouTube Data API (live stream status) ---
YOUTUBE_API_KEY=your_youtube_data_api_key
# You can get this from the Google Cloud Console.
# Not required if using a custom video ID URL approach.

# --- Email (Nodemailer): contact and prayer request notifications ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password-or-app-password
ADMIN_NOTIFICATION_EMAIL=church-office-address@your-domain


# The admin account is not configured here. Create it with scripts/seedAdmin.js and
# change its password with scripts/resetAdminPassword.js (see README.md).
