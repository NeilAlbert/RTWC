# =============================================================================
# ROYAL TEMPLE WORSHIP CENTRE — API ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
# =============================================================================

# --- Server ---
PORT=5000
# Comma-separated list of allowed origins for CORS (no trailing slash).
# The site's own domain(s) only.
CORS_ORIGIN=https://royaltemple.org,https://www.royaltemple.org

# --- MySQL / Aiven ---
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-strong-password
DB_NAME=royaltemple
# Optional: path (relative to server/) to the Aiven CA certificate (ca.pem).
# Recommended for certificate pinning. If omitted, SSL is still enforced
# with rejectUnauthorized: true against the system CA store.
DB_SSL_CA=./certs/ca.pem

# --- JWT Auth ---
# IMPORTANT: Generate this with `openssl rand -hex 64` — never type it by hand.
# It must be a long, random string (64 bytes of hex = 128 chars).
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_64_OUTPUT
# Token lifetime. 24h per spec.
JWT_EXPIRES_IN=24h

# --- Facebook Graph API (live stream + gallery) ---
PAGE_ID=your_facebook_page_id
# Page ID for https://www.facebook.com/cop.rtwc
# The numeric page ID can be found in the Page's About > Page transparency section# or via the Graph API Explorer (developers.facebook.com/tools/explorer)
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# --- You Live API ---
YOUTUBE_API_KEY=your_youtube_data_api_key
# You can get this from the Google Cloud Console.
# Not required if using a custom video ID URL approach.
# --- Email (Nodemailer) — contact/prayer notifications + giving receipts ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password-or-app-password
ADMIN_NOTIFICATION_EMAIL=info@royaltemple.org

# --- Payment methods (offline giving only)
# Church accepts manual mobile money and bank transfers.
# Payment provider keys are NOT required.
PAYSTACK_SECRET_KEY=not-required
PAYSTACK_PUBLIC_KEY=not-required
# PAYSTACK_CALLBACK_URL removed — no webhook or hosted checkout

# --- Admin seed script (one-time, optional if CLI args used) ---
ADMIN_NAME=Royal Temple Admin
ADMIN_EMAIL=admin@royaltemple.org
ADMIN_PASSWORD=change-me-at-least-8-chars
