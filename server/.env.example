# Royal Temple Worship Centre API settings.
# Copy this file to server/.env and fill it in. Never put real values in this file.
# Check the result with: npm run check:env

# --- Server ---
# Port the API and website listen on. Optional, default 5000.
PORT=5000
# Other web addresses allowed to call the API from a browser, comma-separated, no
# trailing slash. The site's own address is always allowed, so this can stay empty
# when the pages and the API share one address. Optional.
CORS_ORIGIN=
# Number of reverse proxies between visitors and this server: 1 behind Nginx or a
# hosting provider's proxy, 2 behind Cloudflare and Nginx, 0 when browsers reach it
# directly. The rate limits depend on it being right. Optional, default 1.
TRUST_PROXY_HOPS=1
# The site's public web address, e.g. https://www.example.org (https, no trailing
# slash, the one host visitors should use: with or without www). Search engines and
# link previews need it: it fills the canonical links, share image, home page Church
# details, /sitemap.xml and the Sitemap: line in robots.txt. Optional, but without
# it none of those are sent.
SITE_URL=

# --- Database (Aiven MySQL) ---
# Database host name. REQUIRED. Aiven console > your MySQL service > Overview.
DB_HOST=
# Database port. Optional, default 3306. Aiven console > Overview.
DB_PORT=3306
# Database user. REQUIRED. Aiven console > Overview (usually the admin user).
DB_USER=
# Database password. Required by Aiven. Aiven console > Overview.
DB_PASSWORD=
# Database name. REQUIRED. Aiven console > Databases.
DB_NAME=
# Path to the Aiven CA certificate (ca.pem), relative to server/ or absolute.
# Optional: when empty, TLS is still enforced against the system certificate store.
# Download it from Aiven console > Overview > CA certificate.
DB_SSL_CA=
# Set to false ONLY for MySQL on this same computer (no TLS). Leave out or empty for
# Aiven or any hosted database. Optional.
# DB_SSL=false

# --- Security ---
# Signs admin sign-in tokens. REQUIRED, at least 32 characters; the server will not
# start otherwise. Generate with: openssl rand -hex 64. Changing it signs out every admin.
JWT_SECRET=

# --- Email (contact and prayer request notifications) ---
# SMTP server, e.g. smtp.gmail.com. Optional: without host, user and password, emails are skipped.
EMAIL_HOST=
# SMTP port. 465 uses TLS from the start; other ports use STARTTLS. Default 465.
EMAIL_PORT=465
# SMTP user name; also the "from" address. From your email provider.
EMAIL_USER=
# SMTP password (for Gmail, an app password: Google account > Security > App passwords).
EMAIL_PASSWORD=
# Address that receives the notifications. Optional.
ADMIN_NOTIFICATION_EMAIL=

# --- Facebook (live stream and gallery) ---
# Numeric ID of the church Facebook Page. Optional. Page > About > Page transparency,
# or the Graph API Explorer (developers.facebook.com/tools/explorer).
PAGE_ID=
# Long-lived Page access token for the Graph API. Optional. Meta for Developers >
# your app > Graph API Explorer, then exchange it for a long-lived token.
FB_PAGE_ACCESS_TOKEN=

# --- YouTube (live stream status) ---
# YouTube Data API key. Optional. Google Cloud Console > APIs & Services > Credentials.
YOUTUBE_API_KEY=

# --- Redis (optional shared cache and rate limits; see REDIS.md) ---
# true to use Redis. Optional, default false (cache and limits stay in memory).
REDIS_ENABLED=false
# redis://:PASSWORD@HOST:6379/0, or rediss:// for TLS. The Redis password goes inside
# this URL. Required only when REDIS_ENABLED=true. From your Redis provider.
REDIS_URL=
# Prefix added to every key. Optional, default rtwc:
REDIS_PREFIX=rtwc:

# --- Backups (Admin > Backups; see BACKUPS.md) ---
# Folder for encrypted backups, relative to server/ or absolute. Optional, default backups.
BACKUP_DIR=backups
# Passphrase for the automatic monthly backups (at least 12 characters). Needed only
# when automatic backups are switched on in Admin > Backups. Keep a copy in a password
# manager: without it the automatic backups cannot be opened. openssl rand -base64 32
BACKUP_PASSPHRASE=
# Largest backup allowed, in bytes. Optional, default 1073741824 (1 GB).
BACKUP_MAX_BYTES=1073741824
# Largest backup file that may be uploaded to restore from, in MB. Optional, default 500.
BACKUP_MAX_UPLOAD_MB=500
# Automatic backups to keep (2 to 24) when none is saved on the Backups page. Optional, default 6.
BACKUP_KEEP_AUTO=6
