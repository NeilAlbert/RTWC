/**
 * ROYAL TEMPLE WORSHIP CENTRE - Environment Variables Example
 * Copy this file to .env and fill in all values
 * 
 * ⚠️  Never commit .env to version control!
 */

# ========================================
# Server Configuration
# ========================================
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# ========================================
# Database Configuration
# ========================================
# Aiven MySQL requires SSL; set DB_SSL_CA path if needed
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=royal_temple_db
DB_SSL_CA=optional/path/to/aiven-ca.pem

# ========================================
# JWT Authentication
# ========================================
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# ========================================
# Facebook Integration (for later phases)
# ========================================
PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# ========================================
# Paystack Integration (for later phases)
# ========================================
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ========================================
# Email Configuration (for later phases)
# ========================================
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=your_email_username_here
EMAIL_PASSWORD=your_email_password_here
ADMIN_NOTIFICATION_EMAIL=admin@royaltemple.org

# ========================================
# Application Settings
# ========================================
# Will be populated from site_settings table after DB init
PAGE_ID=your_page_identifier_here